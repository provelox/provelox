# Required: signs login tokens (32+ characters). Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-32chars

# First start only. If unset, a random password is generated and printed once to the log. There is no default.
# ADMIN_PASSWORD=

PORT=4000
DATA_DIR=./data
DOCKER_SOCKET=/var/run/docker.sock

# Apps are served at <app>.<ROOT_DOMAIN> (can also be set at runtime: PUT /v1/system/domain)
# ROOT_DOMAIN=apps.example.com

# Runs until an app's first real deploy
PLACEHOLDER_IMAGE=nginx:alpine
CERT_RESOLVER=le
SESSION_HOURS=8

# Proxy (Traefik, managed by the API). Spare ports are handy when another proxy already owns 80/443.
# PROXY_ENABLED=true
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
# TRAEFIK_IMAGE=traefik:v3.6
# ACME_EMAIL=you@example.com
# ACME_STAGING=false

# Custom error pages need the proxy to reach this API as a Traefik service. `bootstrap` sets this for you.
# ERROR_PAGES_SERVICE=pvx_error_pages@swarm

# Short-lived container used to copy data when moving an unnamed volume into a named one (needs cp and diff)
# HELPER_IMAGE=busybox:latest

# Any value can instead come from a file (Docker secrets): JWT_SECRET_FILE=/run/secrets/jwt
